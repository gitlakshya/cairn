{
  "name": "contexit",
  "version": "3.1.0",
  "description": "contexIT — AI-powered repository wiki with OKF frontmatter and git-synchronized surgical updates",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "contexit": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "init": "node dist/index.js --init",
    "sync": "node dist/index.js --update",
    "configure-triggers": "node dist/index.js --configure-triggers",
    "help": "node dist/index.js --help"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "contexit",
    "repository",
    "context",
    "wiki",
    "documentation",
    "ai",
    "okf",
    "mcp"
  ],
  "author": "",
  "license": "MIT"
}
